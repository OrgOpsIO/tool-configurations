# Domain Configuration
DOMAIN_NAME=orgops.io
SUBDOMAIN=vibekanban

# PostgreSQL Configuration
POSTGRES_DB=remote
POSTGRES_USER=vibekanban
POSTGRES_PASSWORD=replace_me

# JWT Secret (required)
# Generate with: openssl rand -base64 32
VIBEKANBAN_REMOTE_JWT_SECRET=replace_me

# ElectricSQL Configuration
ELECTRIC_ROLE_PASSWORD=replace_me

# GitHub OAuth (configure at least one OAuth provider)
# Callback URL: https://vibekanban.orgops.io/v1/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth (alternative to GitHub)
# Callback URL: https://vibekanban.orgops.io/v1/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Email invitations via Loops
# LOOPS_EMAIL_API_KEY=

# Azurite Public Endpoint (for file attachments)
# Set this to a publicly accessible URL if attachments need to be served externally
# AZURE_STORAGE_PUBLIC_ENDPOINT_URL=https://vibekanban.orgops.io/attachments

# Optional: GitHub App Integration
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# Optional: Stripe Billing
# STRIPE_SECRET_KEY=
# STRIPE_TEAM_SEAT_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_FREE_SEAT_LIMIT=1
