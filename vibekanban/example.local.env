# Lokale Entwicklungsumgebung

# PostgreSQL Configuration
POSTGRES_DB=vibekanban
POSTGRES_USER=vibekanban
POSTGRES_PASSWORD=localdev

# JWT Secret
VIBEKANBAN_REMOTE_JWT_SECRET=local-dev-secret-replace-me

# ElectricSQL Configuration
ELECTRIC_ROLE_PASSWORD=localdev

# Google OAuth (required)
# Erstelle eine OAuth App unter: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/v1/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
