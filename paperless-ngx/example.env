# Domain Configuration
DOMAIN_NAME=orgops.io
SUBDOMAIN=docs

# Paperless-ngx Admin
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me

# Paperless-ngx Secret Key (change to a long random string!)
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string

# Database Configuration
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=paperless_secure_password

# OCR Configuration (deu=Deutsch, eng=English)
PAPERLESS_OCR_LANGUAGE=deu+eng

# Timezone
PAPERLESS_TIME_ZONE=Europe/Berlin

# User/Group Mapping (match your host UID/GID for file permissions)
#USERMAP_UID=1000
#USERMAP_GID=1000
