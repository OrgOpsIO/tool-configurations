# Domain-Konfiguration
DOMAIN_NAME=example.com
SUBDOMAIN=chat

# Open WebUI
# Generiere mit: openssl rand -hex 32
WEBUI_SECRET_KEY=your-secret-key-here-generate-with-openssl
WEBUI_NAME=Open WebUI

# ─── Lokales vLLM (CPU-Modus) ────────────────────────────────────────────────
# Modell (HuggingFace Model ID)
# CPU-geeignete Modelle (RAM-Bedarf ungefähr):
#   Qwen/Qwen2.5-1.5B-Instruct       (~3 GB)   ← empfohlen zum Testen
#   Qwen/Qwen2.5-3B-Instruct         (~6 GB)
#   microsoft/phi-3.5-mini-instruct  (~8 GB)
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Maximale Kontextlänge (auf CPU klein halten, auf GPU: 4096–8192)
VLLM_MAX_MODEL_LEN=2048

# HuggingFace Token (nur für gated models wie Llama 3 erforderlich)
# Erstellen unter: https://huggingface.co/settings/tokens
HF_TOKEN=

# API Key für lokales vLLM (leer = keine Authentifizierung)
VLLM_API_KEY=

# ─── RunPod Serverless GPU (optional) ────────────────────────────────────────
# Leer lassen solange kein RunPod genutzt wird.
# Anleitung: runpod-setup.md
#
# Nach Einrichtung des Serverless Endpoints:
#   RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1
#   RUNPOD_API_KEY=<dein-runpod-api-key>
#
# Danach: docker compose restart openwebui
# → GPU-Modell erscheint automatisch im Modell-Selector neben lokalem CPU-Modell
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=
