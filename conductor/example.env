# Conductor Konfiguration
# ======================

# GitLab Verbindung
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=your-gitlab-personal-access-token

# Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Webhook Secret (muss mit GitLab Webhook-Konfiguration übereinstimmen)
# Generiere mit: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret

# Pfad zum Conductor Quellcode (für Docker Build)
# Relativ zum docker-compose.yml oder absolut
CONDUCTOR_SOURCE_PATH=../../../conductor

# Pfad zur Pipeline-Konfiguration
CONDUCTOR_CONFIG_PATH=./conductor.yml
