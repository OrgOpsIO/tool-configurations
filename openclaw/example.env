# Domain-Konfiguration fuer OpenClaw
DOMAIN_NAME=orgops.io
SUBDOMAIN=openclaw

# Gateway Token (wird automatisch generiert)
OPENCLAW_GATEWAY_TOKEN=

# Ressourcen-Limits Gateway
OPENCLAW_CPU_LIMIT=1
OPENCLAW_MEMORY_LIMIT=1G
OPENCLAW_CPU_RESERVATION=0.25
OPENCLAW_MEMORY_RESERVATION=256M

# Ressourcen-Limits CLI
OPENCLAW_CLI_CPU_LIMIT=0.5
OPENCLAW_CLI_MEMORY_LIMIT=512M

# API Keys werden ueber das Onboarding konfiguriert:
#   docker compose --profile cli run --rm openclaw-cli onboard
# oder im Control UI unter http://127.0.0.1:18789
