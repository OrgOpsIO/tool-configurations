# GitLab CE Konfiguration
# ======================

# Domain für GitLab (muss im DNS auf diesen Server zeigen)
GITLAB_HOSTNAME=gitlab.example.com

# GitLab Version
GITLAB_TAG=17.8.1-ce.0

# SSH Port (extern, da 22 meist belegt)
GITLAB_SSH_PORT=2222

# Performance (anpassen je nach Server-RAM)
# Puma Workers: 2 für 4GB RAM, 4 für 8GB+ RAM
GITLAB_PUMA_WORKERS=2
# Sidekiq Concurrency: 10 für 4GB RAM, 25 für 8GB+ RAM
GITLAB_SIDEKIQ_CONCURRENCY=10

# Prometheus Monitoring (benötigt zusätzlich ~200MB RAM)
GITLAB_PROMETHEUS=false

# SMTP Konfiguration für E-Mail-Versand
# Wird benötigt für: Registrierung, Passwort-Reset, Benachrichtigungen
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=gitlab@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_DOMAIN=example.com
GITLAB_EMAIL_FROM=gitlab@example.com
GITLAB_EMAIL_REPLY_TO=noreply@example.com
